<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <!-- 系統權限區塊 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="系統權限" />

            <TextView
                android:id="@+id/tvAccStatus"
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_status"
                android:padding="12dp"
                android:text="無障礙服務：檢查中" />

            <Button
                android:id="@+id/btnOpenAccessibility"
                style="@style/AppButton"
                android:layout_marginTop="12dp"
                android:text="開啟無障礙服務" />

            <TextView
                android:id="@+id/tvOverlayStatus"
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_status"
                android:padding="12dp"
                android:text="上層顯示權限：檢查中" />

            <Button
                android:id="@+id/btnOpenOverlay"
                style="@style/AppButton"
                android:layout_marginTop="12dp"
                android:text="授權顯示在其他應用程式上層" />

            <Button
                android:id="@+id/btnOpenManual"
                style="@style/AppButton"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/surface_soft"
                android:text="查看使用說明"
                android:textColor="@color/brand_primary" />
        </LinearLayout>

        <!-- 保護設定區塊 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="保護設定" />

            <EditText
                android:id="@+id/etPin"
                style="@style/AppField"
                android:layout_marginTop="12dp"
                android:hint="輸入至少 4 碼家長 PIN"
                android:inputType="numberPassword" />

            <Button
                android:id="@+id/btnSetPin"
                style="@style/AppButton"
                android:layout_marginTop="10dp"
                android:text="設定或更新家長 PIN" />

            <EditText
                android:id="@+id/etStopPin"
                style="@style/AppField"
                android:layout_marginTop="16dp"
                android:hint="輸入至少 4 碼停止管控 PIN"
                android:inputType="numberPassword" />

            <Button
                android:id="@+id/btnSetStopPin"
                style="@style/AppButton"
                android:layout_marginTop="10dp"
                android:text="設定或更新停止管控 PIN" />
        </LinearLayout>

        <!-- 時間管控區塊 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="時間管控" />

            <EditText
                android:id="@+id/etLimitMinutes"
                style="@style/AppField"
                android:layout_marginTop="12dp"
                android:hint="單次使用時間（分鐘，1~1440）"
                android:inputType="number" />

            <EditText
                android:id="@+id/etDailyQuota"
                style="@style/AppField"
                android:layout_marginTop="10dp"
                android:hint="每日可解鎖次數（0~100）"
                android:inputType="number" />

            <Button
                android:id="@+id/btnSaveRules"
                style="@style/AppButton"
                android:layout_marginTop="12dp"
                android:text="儲存使用規則" />

            <Button
                android:id="@+id/btnToggleControl"
                style="@style/AppButton"
                android:layout_marginTop="10dp"
                android:text="開始管控" />

            <Button
                android:id="@+id/btnResetTodayQuota"
                style="@style/AppButton"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/surface_soft"
                android:text="重置今日解鎖次數"
                android:textColor="@color/brand_primary" />
        </LinearLayout>

        <!-- 守護距離區塊 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="守護距離" />

            <TextView
                android:id="@+id/tvDistanceStatus"
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_status"
                android:padding="12dp"
                android:text="守護距離：等待偵測" />

            <Button
                android:id="@+id/btnStartDistance"
                style="@style/AppButton"
                android:layout_marginTop="12dp"
                android:text="開啟距離守護" />

            <Button
                android:id="@+id/btnStopDistance"
                style="@style/AppButton"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/surface_soft"
                android:text="關閉距離守護"
                android:textColor="@color/danger" />

            <Button
                android:id="@+id/btnCalibrate30"
                style="@style/AppButton"
                android:layout_marginTop="10dp"
                android:text="進行 30 公分校正" />
        </LinearLayout>

        <!-- 全域狀態提示 -->
        <TextView
            android:id="@+id/tvStatus"
            style="@style/BodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:background="@drawable/bg_status"
            android:padding="16dp"
            android:text="等待設定" />

    </LinearLayout>
</ScrollView>