<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/blockRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overlay_scrim"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_overlay_card"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView android:id="@+id/blockTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="true" android:lineSpacingExtra="4dp" android:text="使用時間已到" android:textColor="@color/text_primary" android:textSize="25sp" android:textStyle="bold" />
        <TextView android:id="@+id/blockMsg" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="請輸入家長 PIN" />
        <TextView android:id="@+id/blockRemaining" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_status" android:gravity="center" android:lineSpacingExtra="4dp" android:padding="12dp" android:text="今日可解鎖：0 次" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
        <EditText android:id="@+id/pinInput" style="@style/AppField" android:layout_marginTop="16dp" android:hint="家長 PIN" android:inputType="numberPassword" android:maxLines="1" />
        <Button android:id="@+id/unlockBtn" style="@style/AppButton" android:layout_marginTop="12dp" android:text="解鎖並繼續使用" />
        <TextView android:id="@+id/stopHint" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center" android:text="停止管控" />
        <EditText android:id="@+id/stopPinInput" style="@style/AppField" android:layout_marginTop="12dp" android:hint="停止管控 PIN" android:inputType="numberPassword" android:maxLines="1" />
        <Button android:id="@+id/stopBtn" style="@style/AppButton" android:layout_marginTop="12dp" android:text="停止管控" />
    </LinearLayout>
</ScrollView>
