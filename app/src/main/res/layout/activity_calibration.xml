<?xml version="1.0" encoding="utf-8"?>
<!-- 設定護眼基準線畫面（直向）：單欄，由上而下為說明、鏡頭、狀態、按鈕 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <!-- ===== 標題橫幅：圖示 + 標題 + 兩個步驟標籤 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="17dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_avatar"
                android:contentDescription="@string/app_name"
                android:padding="5dp"
                android:src="@mipmap/ic_launcher_round" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:autoSizeMaxTextSize="21sp"
                    android:autoSizeMinTextSize="14sp"
                    android:autoSizeTextType="uniform"
                    android:gravity="center_vertical|start"
                    android:maxLines="1"
                    android:text="偵測護眼基準線設定"
                    android:textColor="@color/cute_title"
                    android:textStyle="bold" />

                <!-- 步驟標籤：狀態由 CalibrationActivity.renderSteps() 切換 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvStepLandscape"
                        style="@style/CuteStepTag"
                        android:drawableStart="@drawable/ic_step_landscape"
                        android:text="1 橫屏" />

                    <TextView
                        android:id="@+id/tvStepPortrait"
                        style="@style/CuteStepTag"
                        android:layout_marginStart="6dp"
                        android:drawableStart="@drawable/ic_step_portrait"
                        android:text="2 豎屏" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/section_spacing" />

        <!-- ===== 設定說明卡片 ===== -->
        <LinearLayout
            style="@style/CuteCard"
            android:layout_marginTop="0dp">

            <LinearLayout style="@style/CuteHeaderRow">

                <TextView
                    style="@style/CuteHeaderIcon"
                    android:background="@drawable/bg_icon_yellow"
                    android:text="💡" />

                <TextView
                    style="@style/CuteSectionTitle"
                    android:text="設定說明" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCalibrationTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tip_box"
                android:lineSpacingExtra="5dp"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:text="保持單一完整臉部置中、光線充足並正對鏡頭。"
                android:textColor="@color/cute_text"
                android:textSize="14sp" />

            <!-- 三個提示標籤：平分寬度，空間不足時自動縮字 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/CuteHintChip"
                    android:background="@drawable/bg_chip_distance"
                    android:drawableStart="@drawable/ic_chip_tape"
                    android:text="相距 30 公分"
                    android:textColor="@color/cute_clear_text" />

                <TextView
                    style="@style/CuteHintChip"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_face"
                    android:drawableStart="@drawable/ic_chip_face"
                    android:text="臉部置中"
                    android:textColor="#A85B00" />

                <TextView
                    style="@style/CuteHintChip"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_light"
                    android:drawableStart="@drawable/ic_chip_bulb"
                    android:text="光線充足"
                    android:textColor="#8A6A00" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 鏡頭預覽：白邊外框 + 圓角內層 + 臉部引導框 ===== -->
        <FrameLayout
            android:id="@+id/cameraFrame"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cal_camera_height"
            android:layout_marginTop="@dimen/section_spacing"
            android:background="@drawable/bg_camera_frame"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="9dp">

            <!-- 內層：深色漸層底，clipToOutline 由程式開啟以切出圓角 -->
            <FrameLayout
                android:id="@+id/cameraInner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_camera_inner">

                <androidx.camera.view.PreviewView
                    android:id="@+id/previewView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <owo.eye.care.assistant.ui.FaceGuideView
                    android:id="@+id/faceGuide"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_camera_badge"
                    android:drawableStart="@drawable/ic_badge_camera"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="鏡頭預覽"
                    android:textColor="@color/cute_title"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </FrameLayout>

        <!-- ===== 收集狀態卡片 ===== -->
        <LinearLayout style="@style/CuteCard">

            <LinearLayout style="@style/CuteHeaderRow">

                <TextView
                    style="@style/CuteHeaderIcon"
                    android:background="@drawable/bg_icon_mint"
                    android:text="📏" />

                <TextView
                    style="@style/CuteSectionTitle"
                    android:text="收集狀態" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="5dp"
                    android:text="等待相機啟動。"
                    android:textColor="@color/cute_body"
                    android:textSize="14sp" />

                <!-- 有效讀值進度：0～10 -->
                <ProgressBar
                    android:id="@+id/progressReadings"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="8dp"
                    android:importantForAccessibility="no"
                    android:max="10"
                    android:maxHeight="12dp"
                    android:minHeight="12dp"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_cute" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 操作按鈕 ===== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBegin"
            style="@style/CuteButton"
            android:layout_marginTop="14dp"
            android:autoSizeTextType="none"
            android:background="@drawable/bg_btn_cal"
            android:text="開始收集橫屏基準值"
            android:textColor="@color/cute_on_button"
            android:textSize="15sp"
            app:icon="@drawable/ic_cute_wand"
            app:iconGravity="textEnd"
            app:iconPadding="6dp"
            app:iconSize="18dp"
            app:iconTint="@color/cute_on_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/CuteButton"
            android:autoSizeTextType="none"
            android:background="@drawable/bg_btn_mode"
            android:text="完成／返回"
            android:textColor="@color/cute_mode_text"
            android:textSize="15sp"
            app:icon="@drawable/ic_cute_back"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="18dp"
            app:iconTint="@color/cute_mode_text" />
    </LinearLayout>
</ScrollView>
